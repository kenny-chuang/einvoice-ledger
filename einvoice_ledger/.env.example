# Copy this file to .env before changing any value.
# Never commit the real .env file.

# Web server
# Use 127.0.0.1 to allow only this computer, or 0.0.0.0 for trusted LAN access.
EINVOICE_BIND_ADDRESS=0.0.0.0
EINVOICE_PORT=8000
E_INVOICE_TIMEZONE=Asia/Taipei
# Patchright uses headful Chromium inside the Xvfb virtual display.
E_INVOICE_BROWSER_HEADLESS=0
# Optional Docker DNS fallback for the Ministry of Finance portal. Update this
# only when the hostname no longer resolves/reaches the portal from Docker.
EINVOICE_PORTAL_IP=162.159.140.140

# Optional Home Assistant / MQTT integration.
# Leave these empty when MQTT is not used.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
